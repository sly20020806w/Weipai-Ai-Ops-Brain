{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["images", "backendSecret", "authSecret", "databaseSecret", "targetNamespaces", "clusterName", "publicHost", "tlsSecret", "ingressClassName", "ingressEnabled", "temporalAddress", "temporalNamespace", "taskQueue", "resources", "discovery", "temporal"],
  "definitions": {
    "name": {"type": "string", "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$", "maxLength": 63},
    "image": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9./:_-]*@sha256:[0-9a-f]{64}$"},
    "resources": {"type": "object", "additionalProperties": false, "required": ["requests", "limits"], "properties": {
      "requests": {"type": "object", "required": ["cpu", "memory"]},
      "limits": {"type": "object", "required": ["cpu", "memory"]}
    }}
  },
  "properties": {
    "global": {"type": "object"},
    "images": {"type": "object", "additionalProperties": false, "required": ["backend", "frontend"], "properties": {
      "backend": {"$ref": "#/definitions/image"}, "frontend": {"$ref": "#/definitions/image"}
    }},
    "imagePullSecrets": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"$ref": "#/definitions/name"}}}},
    "backendSecret": {"$ref": "#/definitions/name"},
    "authSecret": {"$ref": "#/definitions/name"},
    "databaseSecret": {"$ref": "#/definitions/name"},
    "targetNamespaces": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"$ref": "#/definitions/name"}},
    "clusterName": {"type": "string", "pattern": "^\\S+$", "maxLength": 256},
    "publicHost": {"type": "string", "pattern": "^[a-z0-9]([a-z0-9.-]*[a-z0-9])?$", "maxLength": 253},
    "tlsSecret": {"$ref": "#/definitions/name"},
    "ingressClassName": {"$ref": "#/definitions/name"},
    "ingressEnabled": {"type": "boolean"},
    "temporalAddress": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9.-]*:[0-9]{1,5}$"},
    "temporalNamespace": {"type": "string", "pattern": "^\\S+$"},
    "taskQueue": {"type": "string", "pattern": "^\\S+$"},
    "resources": {"type": "object", "additionalProperties": false, "required": ["api", "worker", "frontend"], "properties": {
      "api": {"$ref": "#/definitions/resources"}, "worker": {"$ref": "#/definitions/resources"}, "frontend": {"$ref": "#/definitions/resources"}
    }},
    "discovery": {"type": "object", "additionalProperties": false, "required": ["scheduleId", "intervalSeconds", "lookbackSeconds"], "properties": {
      "scheduleId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,100}$"},
      "intervalSeconds": {"type": "integer", "minimum": 1, "maximum": 86400},
      "lookbackSeconds": {"type": "integer", "minimum": 1, "maximum": 86400}
    }},
    "temporal": {"type": "object", "properties": {"enabled": {"type": "boolean"}}}
  }
}
